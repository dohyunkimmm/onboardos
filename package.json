{
  "name": "onboardos",
  "version": "17.0.0",
  "private": true,
  "scripts": {
    "release:check": "node scripts/release-contract.js",
    "release:evidence": "node scripts/release-evidence.js",
    "integrity:manifest": "node scripts/public-assets.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:resilience": "playwright test -c playwright.resilience.config.js",
    "test:security": "playwright test -c playwright.security.config.js",
    "test:ux": "playwright test -c playwright.ux.config.js",
    "quality": "node scripts/quality-check.js",
    "test:a11y": "playwright test tests/accessibility.spec.js",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:visual:update": "playwright test tests/visual.spec.js --update-snapshots",
    "test:domain": "playwright test tests/domain.spec.js --project=desktop-chromium",
    "test:keyboard": "playwright test tests/keyboard.spec.js --project=desktop-chromium",
    "test:cross-browser": "playwright test -c playwright.cross-browser.config.js",
    "test:production": "playwright test -c playwright.production.config.js",
    "test:lighthouse": "node scripts/lighthouse-run.js",
    "test:lighthouse:mobile": "node scripts/lighthouse-run.js lighthouserc.mobile.cjs .lighthouseci-mobile",
    "test:visual-system": "playwright test -c playwright.visual-system.config.js",
    "test:design-polish": "playwright test -c playwright.design-polish.config.js",
    "test:experience": "playwright test -c playwright.experience-refinement.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "lighthouse": "13.4.1"
  }
}
